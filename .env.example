# Copy to .env (git-ignored) and fill in. Two helpers populate most of this:
#   go run ./cmd/oauth            — Volvo OAuth2 PKCE flow, writes VOLVO_* fields.
#   go run ./cmd/tibber-discover  — Tibber login + home, vehicle and charger selection.

# ─── Volvo (from developer.volvocars.com + the oauth CLI) ──────────────────
VOLVO_CLIENT_ID=
VOLVO_CLIENT_SECRET=
VOLVO_API_KEY=
VOLVO_VIN=
VOLVO_REFRESH_TOKEN=

# ─── Tibber (undocumented app API — same email/password as the Tibber app) ─
# Leave blank to disable the Tibber push; monitor will still log Volvo state.
TIBBER_EMAIL=
TIBBER_PASSWORD=
TIBBER_HOME_ID=
TIBBER_VEHICLE_ID=
TIBBER_VEHICLE_NAME=
# Charger car selection is independent of TIBBER_VEHICLE_ID (Volvo battery sync).
# tibber-discover records the selected EV_CHARGER and its name-to-ID car map.
TIBBER_CHARGER_NAME=
TIBBER_CHARGER_ID=
TIBBER_CHARGER_VEHICLES=
TIBBER_PREFERRED_VEHICLE_NAME=

# ─── Optional Deco phone presence (WP-007; commissioning required) ─────────
# Disabled by default. Requires the enrolled Bjorn's iPhone Wi-Fi MAC and an
# attended, verified public-key pin for the main Deco router.
PHONE_PRESENCE_ENABLED=false
DECO_ROUTER_URL=https://192.168.68.1
DECO_OWNER_PASSWORD=
DECO_TLS_PUBLIC_KEY_SHA256=
DECO_ENROLLED_PHONE_MAC=
PHONE_PRESENCE_CAR_PRESENT=pappas bil
PHONE_PRESENCE_CAR_ABSENT=Ragnar
PHONE_PRESENCE_STATE_PATH=/data/phone-presence.json

# ─── Runtime tunables ──────────────────────────────────────────────────────
POLL_INTERVAL=3h
TOKEN_STORE_PATH=/data/token.json
TIBBER_TOKEN_STORE_PATH=/data/tibber-token.json
HTTP_ADDR=        # set to e.g. :8080 to enable /healthz and /state endpoints

# ─── Nightly auto-lock (Connected Vehicle API — opt-in) ────────────────────
# Locks the car if it is unlocked at LOCK_SCHEDULE each day. Requires re-auth
# with lock scopes (see README) — blank disables the feature entirely.
# ⚠️ This locks the physical car unattended; read the README safety note first.
LOCK_SCHEDULE=            # e.g. 20:00 (24h HH:MM); blank = disabled
LOCK_TZ=Europe/Stockholm  # zone for LOCK_SCHEDULE; invalid value disables the feature (never falls back to UTC)
TZ=Europe/Stockholm       # log-timestamp readability only
